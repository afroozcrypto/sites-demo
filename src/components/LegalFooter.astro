---
// Rodapé legal PT: identificação (DL 7/2004, art. 10.º), Livro de Reclamações
// Eletrónico (DL 156/2005, alterado pelo DL 74/2017) e entidades RAL (Lei 144/2015, art. 18.º).
interface Ral { nome: string; url: string; }
interface Props { marca: string; firma: string; morada: string; email: string; ral: Ral[]; extra?: string; bg?: string; fg?: string; }
const { marca, firma, morada, email, ral, extra, bg = '#111827', fg = '#f3f4f6' } = Astro.props;
---
<footer class="legal" style={`--bg:${bg};--fg:${fg}`}>
  <div class="wrap">
    <p><strong>{marca}</strong> · {firma} · NIF 000 000 000 <span class="ex">(exemplo)</span></p>
    <p>{morada} · {email}</p>
    {extra && <p>{extra}</p>}
    <p>
      <a class="lr" href="https://www.livroreclamacoes.pt" rel="noopener">Livro de Reclamações Eletrónico</a>
    </p>
    <p class="ral">Em caso de litígio de consumo, pode recorrer a:
      {ral.map((r, i) => <>{i > 0 && ' · '}<a href={r.url} rel="noopener">{r.nome}</a></>)}.
    </p>
    <p class="ex">Marca fictícia criada para demonstração.</p>
  </div>
</footer>
<style>
  .legal { background: var(--bg); color: var(--fg); padding: 2rem 0 2.5rem; font-size: .875rem; }
  .legal p { margin: 0 0 .6rem; }
  .legal a { color: var(--fg); text-underline-offset: 2px; }
  .lr { display: inline-block; padding: .55rem .9rem; border: 2px solid var(--fg); border-radius: .4rem; font-weight: 700; text-decoration: none; min-height: 44px; }
  .ral a { display: inline-block; padding: .3rem 0; }
  .ex { opacity: .85; }
</style>
