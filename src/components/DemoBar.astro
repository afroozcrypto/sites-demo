---
const base = import.meta.env.BASE_URL;
---
<div class="demo-bar" role="note">
  <span>Site de demonstração · <span class="nw">João Conde</span></span>
  <a href={`${base}oferta/`}>Quero um assim</a>
</div>
<style>
  .demo-bar {
    position: fixed; inset: 0 0 auto 0; z-index: 100;
    display: flex; gap: .75rem; align-items: center; justify-content: center;
    height: 3rem; padding: 0 1rem;
    background: #111827; color: #f9fafb;
    font: 600 .8125rem/1.25 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    text-align: center;
  }
  .nw { white-space: nowrap; }
  .demo-bar a {
    color: #111827; background: #fde68a; padding: .3rem .7rem; border-radius: 999px;
    text-decoration: none; white-space: nowrap;
  }
  .demo-bar a:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
</style>
