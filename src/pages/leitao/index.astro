---
import Base from '../../layouts/Base.astro';
import LegalFooter from '../../components/LegalFooter.astro';
import JsonLd from '../../components/JsonLd.astro';
// DEMO: negócio fictício. Nomes, preços, horários e contactos são exemplos.
const url = new URL(Astro.url.pathname, Astro.site).href;
const ld = {
  '@type': 'Restaurant', name: 'Leitoaria Demo', url, servesCuisine: 'Portuguesa', priceRange: '€€',
  address: { '@type': 'PostalAddress', streetAddress: 'Rua do Exemplo, 1', postalCode: '0000-000', addressLocality: 'Bairrada', addressCountry: 'PT' },
};
const encomendas = [
  ['Leitão inteiro', 'Para 10 a 12 pessoas', 'preço de exemplo'],
  ['Meio leitão', 'Para 5 a 6 pessoas', 'preço de exemplo'],
  ['Quarto de leitão', 'Para 2 a 3 pessoas', 'preço de exemplo'],
];
const passos = [
  ['1', 'Escolha a quantidade', 'Inteiro, meio ou quarto.'],
  ['2', 'Marque o dia', 'Diga o dia e a hora a que vem buscar.'],
  ['3', 'Confirme por WhatsApp', 'Recebe a confirmação com o valor.'],
];
---
<Base title="Leitoaria Demo · Leitão assado e encomendas de Natal (demonstração)" description="Demonstração de site para casa de leitão: encomendas de Natal, ementa e contactos. Negócio fictício." themeColor="#7c2d12">
  <JsonLd slot="head" data={ld} />
  <header class="hero">
    <div class="wrap">
      <p class="eyebrow">DEMO · negócio fictício</p>
      <h1>Leitoaria Demo</h1>
      <p class="lead">Leitão assado em forno a lenha. Encomendas para o Natal com dia e hora marcados.</p>
      <div class="ctas">
        <a class="btn btn-main" href="#natal">Encomendar para o Natal</a>
        <a class="btn btn-alt" href="#ementa">Ver ementa</a>
      </div>
    </div>
  </header>

  <main>
    <section id="natal">
      <div class="wrap">
        <h2>Encomendas de Natal</h2>
        <p>Encomende com antecedência e venha buscar no dia marcado. <span class="note">(datas e preços de exemplo)</span></p>
        <div class="grid grid-3">
          {encomendas.map(([t, d, p]) => <div class="card"><h3>{t}</h3><p>{d}</p><p class="price">{p}</p></div>)}
        </div>
        <ol class="steps">
          {passos.map(([n, t, d]) => <li><span class="n" aria-hidden="true">{n}</span><div><h3>{t}</h3><p>{d}</p></div></li>)}
        </ol>
        <a class="btn btn-main" href="#natal">Encomendar por WhatsApp</a>
        <p class="note">Num site real, este botão abre o WhatsApp da casa com a mensagem da encomenda já escrita.</p>
      </div>
    </section>

    <section id="ementa" class="alt">
      <div class="wrap">
        <h2>Ementa</h2>
        <ul class="menu">
          <li><span>Leitão assado (dose)</span><span class="price">preço de exemplo</span></li>
          <li><span>Sandes de leitão</span><span class="price">preço de exemplo</span></li>
          <li><span>Batata frita caseira</span><span class="price">preço de exemplo</span></li>
          <li><span>Salada da casa</span><span class="price">preço de exemplo</span></li>
        </ul>
        <p class="note">Informação sobre alergénios disponível na casa.</p>
      </div>
    </section>

    <section id="contacto">
      <div class="wrap grid grid-2">
        <div>
          <h2>Horário</h2>
          <dl class="hours">
            <dt>Terça a domingo</dt><dd>12h00–15h00 · 19h00–22h00 <span class="note">(exemplo)</span></dd>
            <dt>Segunda</dt><dd>Encerrado</dd>
          </dl>
        </div>
        <div>
          <h2>Contacto</h2>
          <p>Rua do Exemplo, 1 · Bairrada <span class="note">(morada fictícia)</span></p>
          <p><strong>Telefone:</strong> 000 000 000 <span class="note">(número de exemplo)</span></p>
        </div>
      </div>
    </section>
  </main>

  <LegalFooter marca="Leitoaria Demo" firma="Leitoaria Demo, Lda. (fictícia)" morada="Rua do Exemplo, 1 · Bairrada" email="encomendas@exemplo.pt" bg="#1c1917" fg="#f5f5f4"
    ral={[{ nome: "CNIACC, Centro Nacional de Informação e Arbitragem de Conflitos de Consumo", url: "https://www.cniacc.pt" }]} />
</Base>

<style>
  :root { --c: #7c2d12; --c2: #fff7ed; }
  .hero { background: linear-gradient(160deg, #3b0d02, #7c2d12 60%, #b45309); color: #fff; padding: 3.5rem 0 3rem; }
  .eyebrow { text-transform: uppercase; letter-spacing: .08em; font-size: .8rem; font-weight: 700; color: #fed7aa; }
  h1 { font-size: clamp(2.2rem, 8vw, 3.6rem); }
  .lead { font-size: 1.15rem; max-width: 34rem; }
  .ctas { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.5rem; }
  .btn-main { background: #fde68a; color: #3b0d02; }
  .btn-alt { border: 2px solid #fff; color: #fff; }
  #natal .btn-main { background: var(--c); color: #fff; }
  h2 { color: var(--c); font-size: 1.8rem; }
  .card { background: var(--c2); border-radius: .75rem; padding: 1.25rem; }
  .card h3 { font-size: 1.1rem; }
  .price { font-weight: 700; color: var(--c); margin: 0; }
  .steps { list-style: none; padding: 0; margin: 1.5rem 0; display: grid; gap: 1rem; }
  .steps li { display: flex; gap: 1rem; align-items: flex-start; }
  .steps h3 { font-size: 1.05rem; margin-bottom: .2em; }
  .n { flex: none; width: 2.4rem; height: 2.4rem; border-radius: 50%; background: var(--c); color: #fff; display: grid; place-items: center; font-weight: 800; }
  .alt { background: #fafaf9; }
  .menu { list-style: none; margin: 0; padding: 0; max-width: 36rem; }
  .menu li { display: flex; justify-content: space-between; gap: 1rem; padding: .6rem 0; border-bottom: 1px dashed #fdba74; }
  .menu .price { white-space: nowrap; }
  .hours { display: grid; grid-template-columns: auto 1fr; gap: .4rem 1rem; margin: 0; }
  .hours dt { font-weight: 700; } .hours dd { margin: 0; }
</style>
